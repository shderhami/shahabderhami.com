---
import Base from '../layouts/Base.astro';
import PostListItem from '../components/PostListItem.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { SITE, PROFILES } from '../consts';
import { getSortedPosts } from '../lib/posts';
import about from '../data/about.json';
import publications from '../data/publications.json';

const posts = await getSortedPosts();

// The research summary is taken verbatim from the About bio: the first
// sentence names the role (shown above), the rest describes the research.
const sentences = about.bioText.split(/(?<=\.)\s+/);
const researchSummary = sentences.slice(1).join(' ');

const journals = publications.find((s) => /journal/i.test(s.section));
const selected = (journals?.items ?? []).slice(0, 4);
---

<Base title={SITE.title} description={SITE.description} path="/">
  <header class="hero">
    <p class="kicker">{SITE.role}</p>
    <h1>{SITE.title}</h1>
    <p class="hero__affiliation">
      <a href={SITE.affiliationUrl} target="_blank" rel="noopener">School of Management</a>,
      Binghamton University
    </p>
    <p class="hero__summary">{researchSummary}</p>

    <ul class="link-row hero__links">
      {
        PROFILES.map((p, i) => (
          <li>
            <a
              class={`button${i === 0 ? ' button--accent' : ''}`}
              href={p.href}
              target={p.href.startsWith('/') ? undefined : '_blank'}
              rel={p.href.startsWith('/') ? undefined : 'noopener'}
            >
              {p.label}
            </a>
          </li>
        ))
      }
    </ul>
  </header>

  <section class="home-section" aria-labelledby="selected-publications">
    <div class="home-section__head">
      <h2 id="selected-publications">Selected publications</h2>
      <a class="home-section__more" href="/publications/">All publications →</a>
    </div>
    <ol class="publication-list">
      {selected.map((item) => <PublicationEntry item={item} />)}
    </ol>
  </section>

  <section class="home-section" aria-labelledby="recent-posts">
    <div class="home-section__head">
      <h2 id="recent-posts">Recent posts</h2>
      <a class="home-section__more" href="/blog/">All posts →</a>
    </div>
    <ul class="post-list">
      {posts.map((post) => <PostListItem post={post} headingLevel="h3" />)}
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-bottom: clamp(2.5rem, 6vw, 3.5rem);
    border-bottom: 1px solid var(--border);
  }

  .hero h1 {
    margin-bottom: 0.4rem;
  }

  .hero__affiliation {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.22rem);
    color: var(--text-muted);
    margin: 0 0 1.5rem;
  }

  .hero__summary {
    max-width: var(--measure);
    margin: 0 0 1.85rem;
  }

  .hero__links {
    margin-top: 0.25rem;
  }

  .home-section {
    margin-top: clamp(2.75rem, 7vw, 4rem);
  }

  .home-section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1.5rem;
    margin-bottom: 1.75rem;
  }

  .home-section__head h2 {
    margin: 0;
  }

  .home-section__more {
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .home-section__more:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
