---
import Base from '../layouts/Base.astro';
import PostListItem from '../components/PostListItem.astro';
import { SITE, PROFILES } from '../consts';
import { getSortedPosts, groupByYear } from '../lib/posts';
import taxonomies from '../data/taxonomies.json';

const posts = await getSortedPosts();
const byYear = groupByYear(posts);
---

<Base title={SITE.title} description={SITE.description} path="/">
  <!-- The site header already shows the name and tagline, so the home page
       carries no visible title: a one-line intro, the categories, the posts. -->
  <header class="home-intro">
    <h1 class="sr-only">{SITE.title}</h1>
    <p class="home-intro__role">
      {SITE.role} at the
      <a href={SITE.affiliationUrl} target="_blank" rel="noopener">School of Management</a>,
      Binghamton University.
    </p>
    <div class="home-intro__row">
      <ul class="tag-list home-intro__cats" aria-label="Categories">
        {
          taxonomies.categories.map((c) => (
            <li>
              <a class="tag" href={`/category/${c.slug}/`}>
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="home-intro__profiles" aria-label="Profiles">
        {
          PROFILES.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="me noopener">
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </header>

  {
    byYear.map(([year, yearPosts]) => (
      <section>
        <h2 class="year-heading">{year}</h2>
        <ul class="post-list">
          {yearPosts.map((post) => (
            <PostListItem post={post} headingLevel="h3" />
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .home-intro {
    padding-bottom: clamp(1.5rem, 4vw, 2.25rem);
    margin-bottom: clamp(2rem, 5vw, 3rem);
    border-bottom: 1px solid var(--border);
  }

  .home-intro__role {
    margin: 0 0 1.1rem;
    font-size: 1.075rem;
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .home-intro__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .home-intro__profiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
  }

  .home-intro__profiles a {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
  }

  .home-intro__profiles a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
