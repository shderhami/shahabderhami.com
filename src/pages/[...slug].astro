---
import Base from '../layouts/Base.astro';
import { formatDate, isoDate } from '../consts';
import { getSortedPosts, type Post } from '../lib/posts';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getSortedPosts();

  return posts.map((post, i) => ({
    // The original WordPress permalink, e.g. "research/optimal-lane-depth..."
    params: { slug: post.data.permalink.replace(/^\/|\/$/g, '') },
    props: {
      post,
      // posts are newest-first, so the *next* index is the older post
      newer: i > 0 ? posts[i - 1] : null,
      older: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
const { title, date, updated, description, category, tags, permalink } =
  post.data;
const { Content } = await render(post);

const showUpdated =
  updated && Math.abs(updated.valueOf() - date.valueOf()) > 24 * 60 * 60 * 1000;
---

<Base
  title={title}
  description={description}
  path={permalink}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
>
  <article class="post">
    <header class="post-head">
      <p class="post-meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        <span class="post-meta__sep" aria-hidden="true">·</span>
        <a href={`/category/${category.slug}/`}>{category.name}</a>
      </p>
      <h1>{title}</h1>
      {description && <p class="post-head__lede">{description}</p>}
      {
        showUpdated && (
          <p class="post-head__updated muted small">
            Updated <time datetime={isoDate(updated!)}>{formatDate(updated!)}</time>
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      tags.length > 0 && (
        <footer class="post-tags">
          <h2 class="kicker">Tagged</h2>
          <ul class="tag-list">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={`/tag/${tag.slug}/`}>
                  {tag.name}
                </a>
              </li>
            ))}
          </ul>
        </footer>
      )
    }
  </article>

  <nav class="post-nav" aria-label="More posts">
    {
      older ? (
        <a class="post-nav__link post-nav__link--prev" href={older.data.permalink}>
          <span class="post-nav__dir">Older</span>
          <span class="post-nav__title">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer ? (
        <a class="post-nav__link post-nav__link--next" href={newer.data.permalink}>
          <span class="post-nav__dir">Newer</span>
          <span class="post-nav__title">{newer.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</Base>

<style>
  .post-head {
    margin-bottom: clamp(2rem, 5vw, 2.75rem);
  }

  .post-head h1 {
    margin: 0.65rem 0 0;
  }

  .post-head__lede {
    margin: 1rem 0 0;
    font-size: 1.075rem;
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .post-head__updated {
    margin: 0.75rem 0 0;
  }

  .post-tags {
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .post-tags .kicker {
    margin-bottom: 0.85rem;
  }
</style>
