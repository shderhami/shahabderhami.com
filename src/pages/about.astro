---
import Base from '../layouts/Base.astro';
import { SITE, PROFILES } from '../consts';
import about from '../data/about.json';

const description =
  about.bioText ||
  'About Shahab Derhami, Assistant Professor of Business Analytics and Operations at Binghamton University.';
---

<Base title="About" description={description} path="/about/">
  <header class="page-head">
    <p class="kicker">About</p>
    <h1>{SITE.title}</h1>
    <p class="page-head__lede">{SITE.role}</p>
  </header>

  <div class="bio">
    {
      about.headshot && (
        <img
          class="bio__portrait"
          src={about.headshot.src}
          alt={about.headshot.alt}
          width={about.headshot.width ?? undefined}
          height={about.headshot.height ?? undefined}
          decoding="async"
        />
      )
    }
    <div class="bio__text prose" set:html={`<p>${about.bioHTML}</p>`} />
  </div>

  <section class="about-links" aria-labelledby="elsewhere">
    <h2 id="elsewhere" class="kicker">Elsewhere</h2>
    <ul class="link-row">
      {
        PROFILES.map((p) => (
          <li>
            <a
              class="button"
              href={p.href}
              target={p.href.startsWith('/') ? undefined : '_blank'}
              rel={p.href.startsWith('/') ? undefined : 'noopener'}
            >
              {p.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .bio {
    display: grid;
    gap: 1.75rem;
    align-items: start;
  }

  @media (min-width: 38rem) {
    .bio {
      grid-template-columns: 13rem 1fr;
      gap: 2.25rem;
    }
  }

  .bio__portrait {
    width: 100%;
    max-width: 13rem;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    display: block;
  }

  .bio__text :global(p) {
    margin: 0;
  }

  .about-links {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .about-links__note {
    margin: 1rem 0 0;
  }
</style>
