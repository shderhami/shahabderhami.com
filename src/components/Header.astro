---
import { SITE, NAV } from '../consts';

const here = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? here === '/' : here === href || here.startsWith(href);
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a class="site-header__brand" href="/">
      <span class="site-header__name">{SITE.title}</span>
      <span class="site-header__tagline">{SITE.tagline}</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      class="theme-toggle"
      id="theme-toggle"
      type="button"
      aria-label="Switch colour theme"
      title="Switch colour theme"
    >
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
  </div>
</header>
